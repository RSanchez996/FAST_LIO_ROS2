<?xml version="1.0"?>
<package format="3">
  <name>fast_lio</name>
  <version>0.1.2</version>

  <description>
    ROS 2 implementation of FAST-LIO with Livox support,
    REP-105 integration and optimized processing for embedded platforms.
  </description>

  <maintainer email="robcar@cartif.es">
    Roberto Sánchez Carreño
  </maintainer>

  <license>BSD</license>

  <author email="zhangji@cmu.edu">Ji Zhang</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>visualization_msgs</depend>

  <depend>pcl_ros</depend>
  <depend>pcl_conversions</depend>

  <depend>livox_ros_driver2</depend>

  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
